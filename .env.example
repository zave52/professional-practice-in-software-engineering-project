# Server-side configuration for docker compose (copy to .env on the VM).
POSTGRES_DB=cicd_hub_db
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=<strong-database-password>

# Generate both with: openssl rand -hex 32
JWT_SECRET=<at-least-32-random-characters>
GITHUB_TOKEN_ENCRYPTION_KEY=<64-hex-characters>

CLIENT_ORIGIN=http://localhost
API_ORIGIN=http://localhost
COOKIE_SECURE=false
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback

# Comma-separated GitHub logins that receive the Admin role on sign-in
ADMIN_GITHUB_LOGINS=

# Managed by deploy/deploy.sh: commit SHA of the images that are running
IMAGE_TAG=latest

# Optional HTTPS (see docker-compose.https.yml)
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# SITE_ADDRESS=example.com
