# Local development values for running `npm run dev` outside Docker.
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug
CLIENT_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
GITHUB_CLIENT_ID=github-oauth-app-client-id
GITHUB_CLIENT_SECRET=github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
# Comma-separated GitHub logins that receive the Admin role on sign-in
ADMIN_GITHUB_LOGINS=
PGHOST=localhost
PGPORT=5432
PGDATABASE=cicd_hub_db
PGUSER=app_admin
PGPASSWORD=your-postgres-password
